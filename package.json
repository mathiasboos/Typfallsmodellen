{
  "name": "typfallsmodellen",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "check:transpile": "python3 tools/transpile/skatteregler.py --check",
    "check:riksnorm": "python3 tools/extract/extract_riksnorm.py --check",
    "check:ages": "python3 tools/extract/extract_retirement_ages.py --check",
    "check:names": "python3 tools/extract/check_names.py",
    "compare": "npm run compare -w @typfallsmodellen/engine",
    "verify:offline": "node tools/build/verify-offline.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
